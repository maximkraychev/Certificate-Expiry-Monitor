<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1>Recipients</h1>
    <p class="lede">Every address here gets the digest email when a certificate needs attention.</p>
  </div>

  <section class="panel">
    <h2>Add a recipient</h2>
    <form method="post" action="/recipients" class="stacked">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Email
        <input type="email" name="email" placeholder="ops@example.com" autocomplete="off" spellcheck="false" required>
      </label>
      <button type="submit">Add recipient</button>
    </form>
  </section>
</div>

<% if (recipients.length === 0) { %>
  <p class="empty">No recipients yet. Alerts go to every address on this list, so add at least one.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="recipients">
      <thead>
        <tr>
          <th>Email</th>
          <th>Added</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const recipient of recipients) { %>
          <tr>
            <td><%= recipient.email %></td>
            <td><%= formatDateTime(recipient.createdAt) %></td>
            <td class="actions-cell">
              <form method="post" action="/recipients/<%= recipient.id %>/delete">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="small danger">Remove</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/footer') %>
