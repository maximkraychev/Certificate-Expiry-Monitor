<%# Filled in by public/app.js from the data-confirm-* attributes of the form being submitted. %>
<dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-body">
  <div class="confirm-inner">
    <h2 id="confirm-title"></h2>
    <p id="confirm-body"></p>
    <div class="confirm-actions">
      <button type="button" class="secondary" id="confirm-cancel" autofocus>Cancel</button>
      <button type="button" class="destructive" id="confirm-accept"></button>
    </div>
  </div>
</dialog>
